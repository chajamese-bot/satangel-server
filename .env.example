# Copy this file to .env and fill in real values. Never commit .env to git.

# Server
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Sessions — generate a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-this-with-a-long-random-string

# AI explanations (server-side only — never exposed to the browser)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRICE_MONTHLY=price_your_monthly_price_id
STRIPE_PRICE_LIFETIME=price_your_lifetime_price_id
STRIPE_PRICE_DEMOCOURSE=price_your_democourse_price_id
